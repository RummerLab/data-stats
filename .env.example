# Copy to .env (never commit .env).

# Folder on the host holding the Physioshark .xlsx workbooks (mounted read-only).
DATA_PATH=./data

# Host port and bind address for docker compose.
HOST_PORT=8098
HOST_BIND=127.0.0.1

# Public URL; pins protocol/host when the proxy does not send X-Forwarded-Proto.
ORIGIN=http://data.physioshark.org

# Pin an image version (docker-compose.ghcr.yml), e.g. 0.1
# DATA_STATS_IMAGE_TAG=latest
