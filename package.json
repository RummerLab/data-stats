{
	"name": "data-stats",
	"private": true,
	"version": "0.2.7",
	"description": "Physioshark data explorer: 13 seasons of Moorea shark-nursery surveys joined with weather, ocean, tide and climate data.",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "node --test scripts/erddap.test.mjs scripts/external-refresh.test.mjs && vitest run",
		"test:related": "vitest related --run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"lint": "prettier --check --cache --cache-strategy content . && eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ .",
		"format": "prettier --write --cache --cache-strategy content .",
		"db:generate": "drizzle-kit generate",
		"fixture": "node scripts/make-fixture.mjs",
		"social-preview": "node scripts/make-social-preview.mjs",
		"external": "node scripts/fetch-external.mjs",
		"import": "node scripts/import.mjs",
		"start": "node scripts/server.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.6",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.14.0",
		"leaflet": "^1.9.4",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"fflate": "^0.8.3"
	}
}
